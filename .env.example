# ============================================================
# FinToko — Environment Variables Example
# ============================================================
# PENTING:
# 1. Salin file ini menjadi .env:
#    cp .env.example .env (Linux/macOS) atau copy .env.example .env (Windows)
# 2. Isi semua nilai di bawah ini dengan konfigurasi lokal/server yang aman.
# 3. JANGAN PERNAH meng-commit file .env ke repository Git atau menyertakannya dalam ZIP archive release!
# ============================================================

# --- Aplikasi ---
# Pilihan: local, development, staging, production
APP_ENV=local
APP_DEBUG=true

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=GANTI_DENGAN_NAMA_DATABASE
DB_USER=GANTI_DENGAN_DB_USER
DB_PASS=GANTI_DENGAN_PASSWORD_DB_AMAN

# --- MySQL Root (Khusus container Docker) ---
DB_ROOT_PASS=GANTI_DENGAN_ROOT_PASSWORD_AMAN

# --- Setup Admin ---
# Token rahasia sekali pakai untuk inisialisasi akun administrator melalui setup_admin.php
# Di environment production, kosongkan token ini dan hapus file setup_admin.php setelah setup.
SETUP_TOKEN=GANTI_DENGAN_TOKEN_RAHASIA_MINIMAL_32_KARAKTER

# --- Port Mapping (Khusus Docker) ---
WEB_PORT=8080
